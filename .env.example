# Local development uses a SQLite database in .data. No email is sent by default.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
STORAGE_DRIVER=sqlite
SQLITE_PATH=.data/portfolio.db
EMAIL_MODE=preview
# Production: set STORAGE_DRIVER=postgres, migrate the database, and supply secrets.
DATABASE_URL=postgresql://portfolio:replace-me@localhost:5432/portfolio
RESEND_API_KEY=
EMAIL_FROM=Mayank Portfolio <portfolio@your-verified-domain.com>
EMAIL_TO=mayankgupta17may@gmail.com
# Enable real delivery only with EMAIL_MODE=resend and a verified sender domain.
