[{"_1":2},"routes/project",{"_3":4},"data",{"_5":6},"project",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"slug","campusmate","name","CampusMate","kicker","A campus, made easier to explore.","number","04","description","A mobile campus companion with interactive maps, location details, room previews, panoramas, and audio-guided tours.","categories",[71],"stack",[66,67,68,69,70],"image","/images/campusmate.webp","imageAlt","CampusMate mobile campus navigation application","accent","peach","github","https://github.com/Mayank2142/Campus-Mate","featured",true,"kind","Collaborative mobile project · Jan–Mar 2026","role","Mobile application development in collaboration with Ritik.","problem","New students need context about campus spaces, not just a map pin: where to go, what is inside, and what a room actually looks like.","solution","Combine campus navigation with detailed location content, room imagery, rich media and a data-backed mobile experience.","architecture",[61,62,63,64,65],"decisions",[50,51,52],"evidence",[47,48,49],"lessons","Useful navigation combines spatial information with the practical questions a student is trying to answer.","Nine application screenshots in the repository","Maps, hostel previews and rich media","Supabase-backed authentication and campus content",{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"title","Keep exploration available","text","A documented local-data fallback lets the interface remain usable during network interruptions.","Design around mobile","Keep navigation, media and location actions accessible within a compact touch interface.","Connect map and context","A location opens meaningful details, amenities and media instead of ending at a marker.","Flutter mobile app","Google Maps and location services","Supabase authentication + PostgreSQL","Panoramas, models and audio","Local mock-data fallback","Flutter","Dart","Supabase","PostgreSQL","Google Maps","Mobile/IoT"]
