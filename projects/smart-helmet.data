[{"_1":2},"routes/project",{"_3":4},"data",{"_5":6},"project",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44},"slug","smart-helmet","name","Smart Helmet","kicker","From sensor signal to a useful alert.","number","03","description","An IoT accident-alert prototype connecting ESP32/MPU6050 telemetry to Firebase and a Flutter monitoring app.","categories",[59],"stack",[55,56,57,58],"accent","cyan","github","https://github.com/Mayank2142/Smart_Helmet","featured",true,"kind","IoT prototype · Mar–Apr 2026","role","IoT and mobile application prototyping.","problem","Sensor readings must become understandable app states and actionable alerts.","solution","Connect motion telemetry, a realtime data layer and mobile monitoring.","architecture",[51,52,53,54],"decisions",[46],"evidence",[45],"lessons","Hardware and software need a shared model of events and failure states.","note","Prototype evidence is not a claim of validated safety performance. Portfolio demonstrations use recorded or simulated events, never real emergency dispatch.","Firmware and Flutter structure documented in source",{"_47":48,"_49":50},"title","Make system state visible","text","Present acceleration, connection and alert states in the app.","ESP32 sensor","Firebase realtime data","Flutter monitoring","Location-tagged alert workflow","ESP32","Flutter","Firebase","MPU6050","Mobile/IoT"]
